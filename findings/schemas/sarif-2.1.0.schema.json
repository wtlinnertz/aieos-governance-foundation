{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aieos.dev/schemas/sarif-2.1.0.schema.json",
  "title": "AIEOS SARIF 2.1.0 subset",
  "description": "Canonical findings format for security.sast, security.dast, security.secret-scan. Subset of OASIS SARIF 2.1.0 covering the fields AIEOS adapters MUST emit. AIEOS-specific additions: tool.driver.version and results[].level are required (upstream makes them optional). Other SARIF fields are permitted but unconstrained.",
  "type": "object",
  "required": ["version", "runs"],
  "properties": {
    "version": { "const": "2.1.0" },
    "$schema": { "type": "string" },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": ["tool", "results"],
      "properties": {
        "tool": { "$ref": "#/$defs/tool" },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/result" }
        }
      }
    },
    "tool": {
      "type": "object",
      "required": ["driver"],
      "properties": {
        "driver": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "informationUri": { "type": "string" },
            "rules": { "type": "array" }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "required": ["ruleId", "level", "message"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "level": { "enum": ["none", "note", "warning", "error"] },
        "message": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "minLength": 1 }
          }
        },
        "locations": { "type": "array" }
      }
    }
  }
}
